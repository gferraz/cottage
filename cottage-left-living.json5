  walls: [
    {
      id: "lower-flight-wall",
      scope: "ground",
      base: { level: "lower-flight.z0" },
      // O topo acompanha a face inferior inclinada do lance.
      top: "stairs",
      path: {
        points: [
          ["lower-flight.x0", "lower-flight.y0"],
          ["lower-flight.x0", "first-landing.y1"],
          ["first-landing.x1", "first-landing.y1"]
        ]
