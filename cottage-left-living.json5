          classes: "furniture table",
          chairs: 0
        },
        {
          label: "Lareira",
          pos: ["living.x0 + 0.2", "living.y1 - 0.7"],
          size: [1.1, 0.5, 1.8],
          classes: "fireplace",
          rotation: 0
        },
        {
          label: "Rack de TV",
          pos: ["living.x1 - 0.6", "living.y0 + 1.3"],
          rotation: 90,
          size: [1.8, 0.45, 0.6],
          color: "furniture",
        },
        {
          type: "rug",
          pos: ["living.x0 + 0.5", "living.y0 + 0.8"],
          rotation: 90,
          size: [3, 2]
        }
      ]
    },
    {
      id: "upper",
      visible: false,
      storey: "upper",
      label: "2º Piso",
      z0: "ground.z0 + params.floor_height",
      slab: {
        visible: false,
        openings: [{
          id: "stair-well",
          parts: [
            { rectangle: ["first-landing.x0", "upper-flight.y0", "upper-flight.x1", "upper-flight.y1"] },
            { rectangle: ["lower-flight.x0", "lower-flight.y0", "lower-flight.x1", "lower-flight.y1"] }
