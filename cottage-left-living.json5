// X = 0 na extremidade esquerda da planta (incluindo o avanço traseiro); X cresce para a direita.
// Origem deslocada 14 m; geometria e implantação no terreno preservadas.
{
  $schema: "./floor-plan.schema.json",
  coordinate_system: "cartesian",
  title: "Cottage Ferraz-César — estar à esquerda",
  summary: "Estar e escritório intercambiados. Estar longitudinal, girado 90°, com 3,70 m de largura alinhada ao jantar e mobiliário redistribuído.",
  coordinates: ["25°45'06.7\"S", "49°15'29.1\"W"],
  viewport: {size: [24, 24], origin: [-25, 1]},
  config: {
    floors: { ceiling_height: "params.floor_height" },
    walls: { thickness: 0.12, color: "desejo-ambar" },
    windows: { model: "cottage-sliding"}
  },
  parameters: { floor_height: 3.1 },
  terrain: {
    front: {edge: ["P001", "P002"], position: "top", label: "RUA/FRENTE"},
    rear: {edge: ["P013", "P014"], position: "bottom", label: "JARDIM"},
    grading: {
      profile: [
        { id: "tp-01-rua", y: 0, z: 0},
        { id: "tp-02-entrada", y: 3.2, z: 0},
        { id: "tp-03-inicio-descida", y: 12, z: -0.5},
        { id: "tp-04-fundos-casa", y: 23.8, z: -2},
        { id: "tp-05-jardim", y: 29, z: -3},
        { id: "tp-06-fundos-terreno", y: 44.32, z: -6}
      ]
    },
    north: {label: "N"},
    unit: "m",
    boundary_order: ["P002", "P001", "P014", "P013"],
    corners: {
      P001: {easting: 674815.253, northing: 7150521.976, z: 0},
      P002: {easting: 674798.334, northing: 7150529.176, z: 0},
      P013: {easting: 674783.457, northing: 7150487.338, z: -6},
      P014: {easting: 674800.113, northing: 7150476.994, z: -6}
    },
    segments: [
      {from: "P001", to: "P002", distance: 18.387, azimuth_deg: 293.052521, azimuth_dms: "293° 03' 09\""},
      {from: "P002", to: "P013", distance: 44.404, azimuth_deg: 199.574666, azimuth_dms: "199° 34' 29\""},
      {from: "P013", to: "P014", distance: 19.607, azimuth_deg: 121.84183, azimuth_dms: "121° 50' 31\""},
      {from: "P014", to: "P001", distance: 47.462, azimuth_deg: 18.601256, azimuth_dms: "18° 36' 05\""}
    ]
  },
  building: {anchor: "terrain.front-start", position: {x: 4, y: 3}, reference: "envelope"},
  zones: [
    { id: "envelope", rectangle: [0, 0, 14, 18.2], visible: true},
    { id: "front-wing", pos: [4, 0], size: [10.2, 2.5], visible: false, color: "red"},
    { id: "main", pos: ["front-wing.x0", "front-wing.y1"], size: ["front-wing.w", 8.8], visible: false, color: "blue"}
  ],
  floors: [
    {
      id: "ground-rear",
      visible: false,
      storey: "ground",
      label: "Térreo traseiro",
      z0: -0.34,
      slab: { visible: false },
      rooms: []
    },
    {
      id: "ground",
      visible: true,
      storey: "ground",
      label: "Térreo frontal",
      z0: 0.3,
      slab: { visible: false },
      stairs: [
        {
          id: "stairs",
          label: "Escada",
          pos: ["foyer.x1 - 1.2", "office.y1 - 2.24", "ground.z0"],
          overlaps: ["master-bedroom", "hallway"],
          overlays: ["master-bedroom", "hallway"],
          parts: [
            { id: "lower-flight",    direction: "+y", to: "z0 + params.floor_height / 2" },
            { id: "first-landing",   direction: "+x" },
            { id: "upper-flight",   direction: "+x", to: "upper.z0", walls: ["front", "rear"] }
          ]
        }
      ],
      rooms: [
        {
          id: "dining",
          label: "Jantar",
          from: ["main.x0", "living.y1"],
          to: ["living.x1", "y0 + 5.5"],
          walls: ["front", "left"]
        },
        {
          id: "foyer",
          label: "foyer",
          classes: "circulation",
          walls: ["front"],
          from: ["living.x1", "main.y0"],
          to:   ["x0 + 2.4", "y0 + 1.56"],
          doors: [
            { from: "front", to: "porch",  opens: "outside", w: 1 },
          ]
        },
        {
          id: "hallway",
          label: "Hallway",
          classes: "circulation",
          rectangle: ["foyer.x0", "foyer.y1", "foyer.x1", "dining.y1"]
        },
        {
          id: "living",
          label: "Estar",
          top: "roofs",
          pos: ["front-wing.x0", "front-wing.y0"],
          size: [3.7, 5.1],
          doors: [{ from: "right", to: "foyer", opens: "inside", transom: true }],
          walls: ["front", "left", "right"],
          windows: [
            { model: "cottage-casement", from: "left", w: 0.6, dx: 0.5 },
            { model: "cottage-casement", from: "left", w: 0.6, dx: 2.7 },
            // Conjunto frontal de 2,80 m, centralizado nos 3,70 m do estar.
            {
              model: "cottage-sliding",
              from: "front",
              w: 0.7,
              dx: 1.15,
              dz: 1.1,
              direction: "up",
              glazing: { columns: 4, rows: 4 }
            },
            {
              model: "cottage-sliding",
              from: "front",
              w: 0.7,
              dx: 1.85,
              dz: 1.1,
              direction: "up",
              glazing: {  columns: 4, rows: 4 }
            },
          ]
        },
        {
          id: "master-bedroom",
          label: "Suíte",
          from: ["office.x0", "office.y1"],
          to: ["main.x1", "y0 + 3.8"],
          // doors: [
          //   { from: "left", w: 1, dy: 2.4 }
          // ],
          walls: ["front", "left", "right"],
          windows: [
            // Janelas laterais com venezianas externas de abrir previstas.
            { model: "cottage-casement", from: "right", w: 0.6, dx: 0.5 },
            { model: "cottage-casement", from: "right", w: 0.6, dx: 2.7 },
          ]
        },
        {
          id: "office",
          label: "Escritório",
          from: ["foyer.x1", "main.y0"],
          to: ["main.x1", "y0 + 3.8"],
          walls: ["front", "rear", "left", "right"],
          doors: [{ from: "left", to: "foyer", w: 0.8, transom: true }],
          windows: [{ model: "cottage-casement", from: "right", w: 0.6, dx: 0.5 }]
        },
        {
          id: "porch",
          label: "Varanda",
          classes: "outdoor porch",
          from: ["living.x1", "front-wing.y0"],
          to: ["front-wing.x1", "y0 + 2.5"],
          walls: []
        },
      ],
      items: [
        {
          id: "master-bed",
