          size: [3.3, 3.8],
          walls: ["front", "rear", "left", "right"]
        },
        {
          id: "porch",
          label: "Varanda",
          classes: "outdoor porch",
          pos: ["office.x1", "front-wing.y0"],
          size: [6.8, 2.5],
          walls: []
        }
      ],
      items: [
        {
          id: "living-sofa",
          type: "three-seat-sofa",
          label: "Sofá",
          pos: ["living.x0 + 1.1", "living.y0 + 0.1"]
        },
        {
          id: "living-armchair-left",
          type: "armchair",
          pos: ["living.x0 + 0.1", "living.yc - 0.425"],
          rotation: 270
        },
        {
          id: "living-armchair-right",
          type: "armchair",
          pos: ["living-sofa.x1 + 0.25", "living-sofa.yc - 0.425"],
          rotation: 0
        },
        {
          id: "living-coffee-table",
          label: "Mesa de centro",
          pos: ["living-armchair-left.x1 + 0.5", "living-sofa.y1 + 0.5"],
