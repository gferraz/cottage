  ],
  floors: [
    {
      id: "ground",
      z0: 0,
      rooms: [
        {
          id: "office",
          label: "Escritório",
          from: [0, 0],
          to: [4, 3],
          walls: ["top", "right", "bottom", "left"]
        }
      ]
    }
  ]
}
