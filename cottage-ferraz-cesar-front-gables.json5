// Planta Cottage Ferraz-César.
//
// ÍNDICE DE EDIÇÃO — use Ctrl+F / Cmd+F para buscar os marcadores abaixo.
// [01] Metadados e apresentação: título, resumo, coordenadas e viewport.
//      [01.1] Configuração — padrões de paredes, telhados, aberturas e pavimentos.
// [01.2] Parâmetros — parameters: espessura, pé-direito e recuo das meias-paredes.
// [02] Terreno e implantação: terrain (limites/cotas) e building (posição).
// [03] Zonas de referência: main, central, top, bottom, left, right e dorm.
// [04] Pavimentos e cômodos:
//      [04.1] Térreo — ground; office, hall, master, stairs, kitchen e garage.
//      [04.2] Dormitórios — upper; unused-north, bedroom-north e zonas headroom-*-2m.
//      Cômodos e partes ordenados alfabeticamente pelo id.
//      Aberturas laterais ficam em rooms[].openings; vãos entre pisos em floors[].openings.
// [05] Paredes independentes:
//      Fachadas — front-wall, left-wall, rear-wall e right-wall.
//      Meias-paredes — IDs com prefixo knee-wall e knee-corner.
// [06] Telhados: main-roof, office-roof e transverse-roof.
// [07] Guias de desenho: w-axis, l-axis e referências das knee-walls.
//
// Para localizar uma definição por ID, busque, por exemplo: id: "left-wall".
// Coordenadas em metros. x0/y0/z0 em "to" referem-se à origem de "from".
// Paredes: top: "roof" termina na cobertura e omite trechos sem telhado acima.
{
  $schema: "./floor-plan.schema.json",

  // [01] Metadados e apresentação
  title: "Cottage Ferraz-César",
  summary: "Residência de dois pavimentos em terreno cadastrado com diferença de cota de 6 m entre frente e fundos.",
  coordinates: ["25°45'06.7\"S", "49°15'29.1\"W"],
  viewport: { size: [24.0, 32.0], origin: [1.0, 1.0] },

  // [01.1] Configuração
  config: {
    // Propriedades de cada elemento têm prioridade sobre os padrões.
    // walls aplica-se somente às paredes independentes.
    walls: {
      base: { level: "ground.z0" },
      top: "roof",
      thickness: "params.wall_thickness",
      color: "desejo-ambar"
    },
    roofs: {
      type: "gable",
      pitch: 51,
      eave: 0.5,
      rake: 0.5
    },
    openings: {
      door: { w: 0.8, h: 2.1, z0: 0 },
      window: { w: 0.9, h: 1.5, z0: 0.9 },
      opening: { w: 1.0, h: 2.1, z0: 0 }
    },
    floors: {
      ceiling_height: "params.ground_height"
    }
  },

  // [01.2] Parâmetros
  // Use params.nome nas medidas e expressões. Valores em metros.
  parameters: {
    // Estrutura e pé-direito
    wall_thickness: 0.12,
    ground_height: 3,

    // Aproveitamento do espaço sob a cobertura
    // Altura livre de 2 m: 2 / tan(51°), arredondado para cima.
    // Recalcular se mudar a inclinação ou a diferença de cota entre piso e base dos telhados.
    headroom_2m_inset: 1.619569,
    // Altura livre de 3 m: 3 / tan(51°), arredondado para cima.
    headroom_3m_inset: 2.429353,
    knee_setback: 0.8
  },

  // [02] Terreno e implantação
  terrain: {
    front: { edge: ["P01", "P02"], position: "top", label: "RUA/FRENTE" },
    rear: { edge: ["P18", "P19"], position: "bottom", label: "JARDIM" },
    north: { label: "N" },
    unit: "m",
    boundary_order: ["P02", "P01", "P19", "P18"],
    corners: {
      P01: { easting: 674802.650, northing: 7150515.678, z: 0 },
      P02: { easting: 674787.417, northing: 7150525.268, z: 0 },
      P18: { easting: 674768.743, northing: 7150486.108, z: -6 },
      P19: { easting: 674787.138, northing: 7150477.614, z: -6 }
    },
    segments: [
      { from: "P01", to: "P02", distance: 18.000, azimuth_deg: 302.192641, azimuth_dms: "302° 11' 34\"" },
      { from: "P02", to: "P18", distance: 43.385, azimuth_deg: 205.494801, azimuth_dms: "205° 29' 41\"" },
      { from: "P18", to: "P19", distance: 20.261, azimuth_deg: 114.785411, azimuth_dms: "114° 47' 07\"" },
      { from: "P19", to: "P01", distance: 41.103, azimuth_deg: 22.1720830, azimuth_dms: " 22° 10' 19\"" }
    ]
  },
  building: { anchor: "terrain.front-start", position: { x: 4, y: 3 } },

  // [03] Zonas de referência
  zones: [
    { id: "attic", inset: ["main", 3.0, 0.0], color: "red", visible: false },
    { id: "bottom",  rectangle: ["main.x0",    "main.y0 + main.l / 2", "main.x1", "main.y1"], visible: false },
    { id: "central", from: ["main.xc - 0.7", "main.y0"], to: ["x0 + 1.4", "main.y1"], visible: false },
    { id: "comfort-zone", inset: ["main", 1.8, 0.0], color: "blue", visible: false },
    {
      id: "dorm",
      rectangle: ["dorm-top.x0", "dorm-top.y0", "dorm-bottom.x1", "dorm-bottom.y1"],
      color: "blue",
      visible: false
    },
    {
      id: "dorm-bottom",
      rectangle: ["bottom.x0", "bottom.y0", "bottom.x1", "bottom.y1 - params.knee_setback"],
      color: "blue",
      visible: false
    },
    { id: "dorm-top", rectangle: ["top.x0", "top.y0 + params.knee_setback", "top.x1", "top.y1"], color: "blue", visible: false },
    { id: "dorm-top-right", rectangle: ["office.x0 + params.knee_setback", "top.y0", "top.x1 - params.knee_setback", "top.y1"], color: "blue", visible: false },
    { id: "hall-roof-base", from: ["hall.x0", "porch.y0"], to: ["hall.x1", "porch.y1"], visible: false },
    { id: "left",    rectangle: ["main.x0",    "main.y0", "central.x0", "central.y1"], visible: false },
    { id: "main",    pos: [0, 2.5], size: [9.6, 9.6], visible: false },
    { id: "office-roof-base", from: ["office.x0", "office.y0"], to: ["hall.x1", "office.y1"], visible: false },
    { id: "perimeter", pos: [0, 2.5], size: [9.6, 12.6], visible: false },
    { id: "right",   rectangle: ["central.x1", "central.y0", "main.x1", "main.y1"], visible: false },
    { id: "top",     rectangle: ["main.x0",    "main.y0", "main.x1", "y0 + main.l / 2"], visible: false }
  ],

  // [04] Pavimentos e cômodos
  floors: [
    // [04.1] Térreo — ground
    {
      id: "ground",
      label: "Térreo",
      z0: 0,
      // Ordem das propriedades: identidade, geometria, paredes, aberturas e aparência.
      // As referências podem apontar para blocos posteriores.
      rooms: [
        {
          id: "circulation",
          label: "Circulação",
          rectangle: ["right.x0", "laundry.y1", "x0 + 2", "y0 + 1"],
          classes: "circulation"
        },
        {
          id: "closet",
          label: "Closet",
          from: ["left.x0", "master.y1"],
          to: ["x0 + 3.2", "y0 + 2.4"],
          openings: [
            { type: "opening", from: "right", to: "vestibule" }
          ]
        },
        {
          id: "dining",
          label: "Jantar",
          from: ["right.x0", "porch.y1"],
          to: ["right.x1", "y0 + 3.4"],
          openings: [
            { type: "window", from: "top", to: "exterior", w: 2.4, h: 1.5 }
          ]
        },
        {
          id: "front-corridor",
          label: "C-1.",
          rectangle: ["master.x1", "hall.y1", "central.x1", "living.y0"],
          walls: ["left"],
          classes: "circulation"
        },
        {
          id: "front-stairs",
          label: "Escada da varanda",
          from: ["porch.x0 + 0.2", "porch.y0 - 1", "porch.z0 - 0.45"],
          to: ["x0 + 2.1", "porch.y0", 0],
          orientation: "longitudinal",
          classes: "stair-flight"
        },
        {
          id: "garage",
          label: "Garagem",
          pos: ["laundry.x1", "laundry.y1"],
          size: [4, 6.5],
          walls: ["top", "right", "bottom"],
          openings: [
            { type: "door", from: "top", to: "exterior", w: 3.2 },
            { type: "door", from: "bottom", to: "exterior", w: 3.2 }
          ],
          classes: "service garage"
        },
        {
          id: "hall",
          label: "Hall",
          from: ["office.x1", "main.y0"],
          to: ["right.x0", "office.y1"],
          walls: ["left"],
          openings: [
            { type: "door", from: "top", to: "porch", w: 1 }
          ],
          classes: "circulation"
        },
        {
          id: "kitchen",
          label: "Cozinha",
          from: ["dorm.x0", "master-bath.y1"],
          to: ["right.x0", "y0 + 3.9"],
          openings: [
            { type: "window", from: "left", to: "exterior", w: 2.4 },
            { type: "door", from: "bottom", to: "terrace" }
          ],
          classes: "wet"
        },
        {
          id: "laundry",
          label: "Lavanderia",
          rectangle: ["right.x0", "upper-flight.y1", "right.x1", "y0 + 1.6"],
          walls: ["left"],
          classes: "service laundry wet"
        },
        {
          id: "living",
          label: "Estar",
          from: ["master.x1", "dining.y1"],
          to: ["right.x1", "y0 + 3.8"]
        },
        {
          id: "master",
          label: "Suíte Master",
          rectangle: ["left.x0", "office.y1", "left.x1 + 0.3", "y0 + 3.2"],
          walls: ["top", "right"],
          openings: [
            { type: "window", from: "left", to: "exterior", dy: 0.6 },
            { type: "window", from: "left", to: "exterior", dy: 2.1 }
          ]
        },
        {
          id: "master-bath",
          label: "Banheiro Master",
          from: ["left.x0", "closet.y1"],
          to: ["left.x1", "knee-bottom.y0"],
          walls: ["top", "bottom", "right"],
          openings: [
            { type: "door", from: "top", to: "vestibule" },
            { type: "window", from: "left", to: "exterior" }
          ],
          classes: "wet"
        },
        {
          id: "mudroom",
          label: "Mudroom",
          rectangle: ["pantry.x1", "laundry.y1", "right.x1", "pantry.y1"],
          openings: [
            { type: "door", from: "right", to: "garage" }
          ],
          classes: "service mudroom"
        },
        {
          id: "office",
          label: "Escritório",
          from: ["left.x0 - 0.8", "left.y0  - 2.5"],
          to: ["left.x1 - 1.1", "left.y0 + 1.5"],
          openings: [
            { type: "door", from: "right", to: "hall" },
            { type: "window", from: "top", w: 0.6, dx: 0.9 },
            { type: "window", from: "top", w: 0.6, dx: 1.5 },
            { type: "window", from: "left" }
          ],
          classes: "office"
        },
        {
          id: "pantry",
          label: "Despensa",
          rectangle: ["right.x0", "circulation.y1", "circulation.x1", "y0 + 1.8"],
          walls: ["top", "right", "left"],
          openings: [
            { type: "opening", from: "top", to: "circulation" }
          ],
          classes: "service pantry"
        },
        {
          id: "porch",
          label: "Varanda",
          from: ["office.x1", "right.y0 - 2.5"],
          to: ["right.x1", "right.y0"],
          classes: "outdoor porch"
        },
        {
          id: "powder",
          label: "Lavabo",
          rectangle: ["right.x0", "living.y1", "x0 + 2.4", "y0 + 1.2"],
          walls: ["top", "left"],
          openings: [
            { type: "door", from: "left", to: "rear-corridor" }
          ],
          classes: "powder wet"
        },
        {
          id: "rear-corridor",
          label: "C-2.",
          rectangle: ["central.x0", "living.y1", "central.x1", "kitchen.y0"],
          walls: ["left"],
          classes: "circulation"
        },
        {
          id: "stairs",
          label: "Escada",
          parts: [
            {
              id: "lower-flight",
              from: ["lower-landing.x0", "lower-landing.y0", "lower-landing.z0"],
              to: ["x0 - 2.7", "lower-landing.y1", 0],
              walls: ["top", "bottom"],
              classes: "stair-flight"
            },
            {
              id: "lower-landing",
              from: ["right.x1", "upper-landing.y1", "upper-landing.z0"],
              to: ["x0 - 1.2", "y0 + upper-flight.l", "z0"],
              walls: ["bottom"],
              classes: "stair-landing",
              color: "terracotta"
            },
            {
              id: "upper-flight",
              from: ["right.x0", "living.y1", "upper.z0"],
              to: ["right.x0 + 2.1", "y0 + 1.2", "z0 - 1.33"],
              classes: "stair-flight"
            },
            {
              id: "upper-landing",
              // z0 é a extremidade inferior do lance, pois as cotas são normalizadas.
              from: ["upper-flight.x1", "upper-flight.y0", "upper-flight.z0"],
              to: ["right.x1", "upper-flight.y1", "z0"],
              classes: "stair-landing",
              color: "terracotta"
            }
          ],
          walls: [],
          overlaps: ["powder", "laundry"],
          overlays: ["powder", "laundry"]
        },
        {
          id: "terrace",
          label: "Terraço Traseiro",
          from: ["kitchen.x0", "kitchen.y1"],
          to: ["kitchen.x1", "y0 +  3"],
          classes: "outdoor terrace"
        },
        {
          id: "vestibule",
          label: "Vest.",
          rectangle: ["closet.x1", "closet.y0", "master.x1", "closet.y1"],
          walls: ["right", "bottom", "left"],
          overlaps: "rear-corridor",
          openings: [
            { type: "door", from: "right", to: "living", dy: 1.3 }
          ]
        }
      ],
      // Mobiliário e equipamentos.
      items: [
        { title: "Mesa", pos: ["dining.x0 + 1.2", "dining.y0 + 1.2"], size: [2.7, 1.1], classes: "table" },
        {
          title: "Lareira",
          pos: ["living.x1 - 0.2", "living.y0 + 0.5"],
          size: [0.5, 1.8],
          classes: "fireplace"
        },
        { title: "Carro", pos: ["garage.x0 + 1", "garage.y0 + 1"], size: [1.8, 4.0], classes: "car" },
        { type: "washing-machine", pos: ["laundry.x1 - 0.7", "laundry.y0"] },
        { type: "washing-machine", pos: ["laundry.x1 - 1.4", "laundry.y0"] },
        { type: "queen-bed", pos: ["master.x0 + 1", "master.y0"] },

        { type: "railing", pos: ["porch.x0",        "porch.y0"], size: ["hall.xc - 0.9 - porch.x0", 0.08, 1.1] },
        { type: "railing", pos: ["hall.xc + 0.9",   "porch.y0"], size: ["porch.x1 - hall.xc - 0.9", 0.08, 1.1] },
        { type: "railing", pos: ["porch.x1 - 0.08", "porch.y0"], size: [0.08, "porch.l", 1.1] }
      ]
    },
    // [04.2] Dormitórios — upper
    {
      id: "upper",
      label: "Dormitórios",
      z0: "params.ground_height",

      rooms: [
        {
          id: "bedroom-north",
          label: "Quarto N",
          from: ["dorm-top.x0", "dorm-top.y0"],
          to: ["knee-left.x0", "dorm-top.y1"],
          walls: [],
          openings: [
            { type: "door", from: "right", to: "playroom", dy: 3 }
          ]
        },
        {
          id: "unused-north",
          label: "Sem uso",
          from: ["office.x0 + params.knee_setback", "office.y0"],
          to: ["office.x1 - params.knee_setback", "dorm-top.y0"]
        }
      ],
      // Altura livre no piso superior: verde >= 2 m; azul >= 3 m.
      // O escritório não tem zona de 3 m: sua altura livre máxima é aproximadamente 2,35 m.
      // Sem beirais; as sobreposições representam regiões atendidas por mais de um telhado.
      zones: [
        {
          id: "headroom-main-roof-2m",
          label: "Telhado principal — altura ≥ 2 m",
          rectangle: [
            "main-roof.x0 + params.headroom_2m_inset",
            "main-roof.y0",
            "main-roof.x1 - params.headroom_2m_inset",
            "main-roof.y1"
          ],
          color: "green"
        },
        {
          id: "headroom-main-roof-3m",
          label: "Telhado principal — altura ≥ 3 m",
          rectangle: [
            "main-roof.x0 + params.headroom_3m_inset",
            "main-roof.y0",
            "main-roof.x1 - params.headroom_3m_inset",
            "main-roof.y1"
          ],
          color: "blue"
        },
        {
          id: "headroom-office-roof-2m",
          label: "Telhado do escritório — altura ≥ 2 m",
          rectangle: [
            "office-roof.x0 + params.headroom_2m_inset",
            "office-roof.y0",
            "office-roof.x1 - params.headroom_2m_inset",
            "office-roof.y1"
          ],
          color: "green"
        },
        {
          id: "headroom-transverse-roof-2m",
          label: "Telhado transversal — altura ≥ 2 m",
          rectangle: [
            "transverse-roof.x0",
            "transverse-roof.y0 + params.headroom_2m_inset",
            "transverse-roof.x1",
            "transverse-roof.y1 - params.headroom_2m_inset"
          ],
          color: "green"
        },
        {
          id: "headroom-transverse-roof-3m",
          label: "Telhado transversal — altura ≥ 3 m",
          rectangle: [
            "transverse-roof.x0",
            "transverse-roof.y0 + params.headroom_3m_inset",
            "transverse-roof.x1",
            "transverse-roof.y1 - params.headroom_3m_inset"
          ],
          color: "blue"
        }
      ],
      // Mobiliário e equipamentos.
      items: [
      ],
      // Aberturas do pavimento; aberturas locais ficam dentro do cômodo.
      openings: [
        { type: "opening", from: "upper", to: "ground", pos: ["stairs.x0", "stairs.y0"], size: ["stairs.w", "stairs.l"] }
      ]
    }
  ],

  // [05] Paredes independentes
  walls: [
    {
      id: "front-wall",
      path: {
        points: [
          ["office.x0", "office.y0"],
          ["office.x1", "office.y0"],
          ["hall.x0", "hall.y0"],
          ["hall.x1", "hall.y0"],
          ["hall.x1", "right.y0"],
          ["right.x1", "right.y0"]
        ]
      },
    },
    {
      id: "knee-wall-office-left",
      scope: "upper",
      path: {
        points: [
          ["office.x0 + params.knee_setback", "office.y0"],
          ["office.x0 + params.knee_setback", "transverse-roof.y0 + params.knee_setback"]
        ]
      },
      base: { level: "upper.z0" },
      color: "blue"
    },
    {
      id: "knee-wall-office-right",
      scope: "upper",
      from: ["office.x1 - params.knee_setback", "office.y0"],
      to: ["office.x1 - params.knee_setback", "transverse-roof.y0 + params.knee_setback"],
      base: { level: "upper.z0" },
      color: "blue"
    },
    {
      id: "knee-wall-rear",
      scope: "upper",
      path: {
        points: [
          ["left.x0", "transverse-roof.y1 - params.knee_setback"],
          ["knee-left.x0", "transverse-roof.y1 - params.knee_setback"],
          ["knee-left.x0", "left.y1"]
        ]
      },
      base: { level: "upper.z0" },
      color: "blue"
    },
    {
      id: "knee-wall-right",
      scope: "upper",
      path: {
        points: [
          ["knee-right.x0", "right.y0"],
          ["knee-right.x0", "transverse-roof.y0 + params.knee_setback"],
          ["right.x1", "transverse-roof.y0 + params.knee_setback"]
        ]
      },
      base: { level: "upper.z0" },
      color: "blue"
    },
    {
      id: "left-wall",
      path: {
        points: [
          ["office.x0", "office.y0"],
          ["office.x0", "office.y1"],
          ["left.x0", "office.y1"],
          ["left.x0", "kitchen.y1"]
        ]
      },
    },
    {
      id: "rear-wall",
      path: {
        points: [
          ["kitchen.x0", "kitchen.y1"],
          ["kitchen.x1", "kitchen.y1"],
          ["pantry.x0", "pantry.y1"],
          ["mudroom.x1", "mudroom.y1"]
        ]
      },
      top: { level: "ground.z1" },
    },
    {
      id: "right-wall",
      from: ["right.x1", "dining.y0"],
      to: ["right.x1", "mudroom.y1"],
    }
  ],

  // [06] Telhados
  roofs: [
    {
      id: "main-roof",
      label: "Telhado Principal",
      rectangle: ["office.x1 - 1.6", "hall.y0", "main.x1", "main.y1"],
      orientation: "longitudinal",
      eave: [0.0, 0.5],
      rake: [0.5, 0.5]
    },
    {
      id: "office-roof",
      label: "Escritório",
      rectangle: ["office.x0", "office.y0", "office.x1", "transverse-roof.y0 + params.knee_setback"],
      orientation: "longitudinal",
    },
    {
      id: "transverse-roof",
      label: "Telhado Transversal",
      from: ["top.x0", "top.y0 + 2", "upper.z0"],
      to: ["top.x1", "bottom.y1 - 1", "z0"],
      orientation: "transverse",
      eave: [0, 0],
    }
  ],

  // [07] Guias de desenho
  guides: [
    { id: "central-left", label: "central esquerda", pos: ["l-axis.x0 - 0.7", -2.5], l: 20, color: "green" },
    { id: "central-right", label: "central direita", pos: ["l-axis.x0 + 0.7", -2.5], l: 20, color: "green" },
    { id: "knee-bottom", label: "meia parede traseira", pos: [-4.0, "dorm.y1"], w: 20, color: "green" },
    { id: "knee-left",   label: "meia parede esquerda", pos: ["main-roof.x0 + params.knee_setback", -2.5], l: 20, color: "terracotta" },
    { id: "knee-right",  label: "meia parede direita",  pos: ["main-roof.x1 - params.knee_setback", -2.5], l: 20, color: "terracotta" },
    { id: "l-axis", label: "eixo longitudinal", pos: ["central.xc", -2.5], l: 20, color: "green" },
    { id: "main-bottom", label: "parede traseira", pos: [-4.0, "main.y1"], w: 20, color: "green" },
    { id: "main-left", label: "parede esquerda", pos: ["left.x0", -2.5], l: 20, color: "green" },
