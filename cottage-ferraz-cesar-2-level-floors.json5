// Planta paramétrica em coordenadas cartesianas.
// X cresce da esquerda para a direita; Y cresce da frente aos fundos (baixo para cima).
// X = 0 na lateral direita do corpo principal; a geometria à esquerda usa X negativo.
// walls e openings: left = x0; right = x1. front = frente; rear = fundos.
// Beirais longitudinais: left/right = x0/x1; transversais: frente/fundos.
// from/to preservam o sentido dos lances de escada; não precisam estar em ordem crescente.
// Terreno cadastral e building permanecem no referencial de implantação.

{
  $schema: "./floor-plan.schema.json",
  coordinate_system: "cartesian",
  title: "Cottage Ferraz-César",
  summary: "Residência de dois pavimentos em terreno cadastrado com diferença de cota de 6 m entre frente e fundos.",
  coordinates: ["25°45'06.7\"S", "49°15'29.1\"W"],
  viewport: { size: [24, 32], origin: [-25, 1] },
  // Configuração
  config: {
    walls: { base: { level: "ground.z0" }, top: "roofs", thickness: "params.wall_thickness", color: "desejo-ambar" },
    roofs: { type: "gable", pitch: 51, thickness: "params.roof_thickness_51", rake: 0.5, eaves: { pitch: 30 } },
    floors: { ceiling_height: "params.floor_height" }
  },
  // Parâmetros
  parameters: {
    wall_thickness: 0.12,
    // Reserva preliminar de 30 cm perpendicular à água: estrutura com isolamento
    // entre peças, canal ventilado livre de aproximadamente 5 cm e acabamentos.
    // thickness é vertical: 0,30 / cos(inclinação), arredondado para cima.
    // A superfície de referência representa o acabamento interno; volume acima dela.
    roof_thickness_51: 0.477,
    roof_thickness_20: 0.320,
    floor_height: 3,
    // Dois espelhos entre os níveis do térreo; piso de 30 cm no corredor.
    ground_step_rise: 0.17,
    ground_step_run: 0.30,
    ground_rear_level: "-2 * params.ground_step_rise",
    upper_rear_level: "params.floor_height + params.ground_rear_level",
    roof_base_offset: 1,
    bed_knee_wall_clearance: 0.3,
    corridor_half_width: 0.7,
    knee_setback: 1,
    knee_height: 1.3
  },
  // Terreno cadastral
  terrain: {
    front: { edge: ["P001", "P002"], position: "top", label: "RUA/FRENTE" },
    rear: { edge: ["P013", "P014"], position: "bottom", label: "JARDIM" },
    // Perfil longitudinal de estudo. IDs e cotas intermediárias provisórios.
    // Y local do terreno; piso térreo = 0. Não são cotas de execução.
    grading: {
      profile: [
        // Patamar plano em toda a largura, da frente à varanda/escritório.
        { id: "tp-01-rua", y: 0, z: 0 },
        { id: "tp-02-entrada", y: 3.2, z: 0 },
        { id: "tp-03-inicio-descida", y: 12, z: -0.5 },
        { id: "tp-04-fundos-casa", y: 23.8, z: -1.5 },
        { id: "tp-05-jardim", y: 29, z: -2 },
        { id: "tp-06-fundos-terreno", y: 44.32, z: -6 }
      ]
    },
    north: { label: "N" },
    unit: "m",
    boundary_order: ["P002", "P001", "P014", "P013"],
    corners: {
      P001: { easting: 674815.253, northing: 7150521.976, z: 0 },
      P002: { easting: 674798.334, northing: 7150529.176, z: 0 },
      P013: { easting: 674783.457, northing: 7150487.338, z: -6 },
      P014: { easting: 674800.113, northing: 7150476.994, z: -6 }
    },
    segments: [
      { from: "P001", to: "P002", distance: 18.387, azimuth_deg: 293.052521, azimuth_dms: "293° 03' 09\"" },
      { from: "P002", to: "P013", distance: 44.404, azimuth_deg: 199.574666, azimuth_dms: "199° 34' 29\"" },
      { from: "P013", to: "P014", distance: 19.607, azimuth_deg: 121.84183, azimuth_dms: "121° 50' 31\"" },
      { from: "P014", to: "P001", distance: 47.462, azimuth_deg: 18.601256, azimuth_dms: "18° 36' 05\"" }
    ]
  },
  // Implantação no terreno
  building: { anchor: "terrain.front-start", position: { x: 4, y: 3 }, reference: "building-placement" },
  // Zonas de referência
  zones: [
    // Implantação estável do corpo térreo; escadas externas não deslocam a casa.
    { id: "building-placement", rectangle: ["garage.x0", "office.y0", "office.x1", "terrace.y1"], visible: false },
    { id: "rear", rectangle: ["main.x0", "main.y0 + main.l / 2", "main.x1", "main.y1"], visible: false },
    { id: "central", from: ["main.xc + params.corridor_half_width", "main.y0"], to: ["x0 - 2 * params.corridor_half_width", "main.y1"], visible: false },
    { id: "house-right", rectangle: ["central.x1", "main.y0", "main.x1", "central.y1"], visible: false },
    { id: "main", pos: [-10, 2.5], size: [10, 8.8], visible: false },
    { id: "house-left", rectangle: ["main.x0", "central.y0", "central.x0", "main.y1"], visible: false },
    { id: "front", rectangle: ["main.x0", "main.y0", "main.x1", "y0 + main.l / 2"], visible: false }
  ],
  // Pavimentos e cômodos
  floors: [
    {
      id: "ground-rear",
      label: "Térreo traseiro",
      z0: "params.ground_rear_level",
      slabs: [{ id: "slab-ground-rear", label: "Laje — Térreo traseiro", thickness: 0.15 }],
      stairs: [
        {
          id: "level-stairs",
          top: "upper-rear.z0",
          label: "Dois degraus — corredor",
          risers: 2,
          from: ["central.x0", "dining.y1", "ground.z0"],
          to: ["master.x0", "y0 + params.ground_step_run", "ground-rear.z0"],
