  ],
  // Guias de desenho
  guides: [
    { id: "central-right", label: "central direita", pos: ["l-axis.x1 + params.corridor_half_width", -3.5], l: 20, color: "green" },
    { id: "central-left", label: "central esquerda", pos: ["l-axis.x1 - params.corridor_half_width", -3.5], l: 20, color: "green" },
