    {
      id: "rear-transverse-roof",
      label: "Telhado dos fundos",
      from: ["garage.x0", "garage.y0"],
      to: ["kitchen.x1", "garage.y1"],
      z0: "upper-rear.z0 + params.roof_base_offset - 1",
      orientation: "transverse",
      pitch: 51,
      eaves: { left: 0.5, right: 0.5 },
      rake: 0.5
    },
    {
      id: "porch-roof",
      label: "Cobertura da varanda",
