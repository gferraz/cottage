  // Paredes independentes
  walls: [
    // Joelhos no limite da altura livre de 1,30 m do segundo piso.
    // Coordenadas calculadas pela face inferior dos telhados desta variante,
    // incluindo suas interseções e recortadas ao contorno dos ambientes.
    // Fechamentos já atendidos pelas paredes existentes não são duplicados.
    {
      id: "garage-knee-wall-front",
      // Ambiente em contato: Quarto dos fundos (bedroom-rear).
      scope: "upper-rear",
      color: "blue",
      base: { level: "upper-rear.z0" },
      top: "roofs",
      from: ["garage.x0", "main.y1"],
      to: ["garage.x1", "y0"]
    },
    {
      id: "garage-knee-wall-rear",
      // Ambiente em contato: Quarto dos fundos (bedroom-rear).
      scope: "upper-rear",
      color: "blue",
      base: { level: "upper-rear.z0" },
      top: "roofs",
      from: ["garage.x0", "kitchen.y1"],
      to: ["garage.x1", "y0"]
    },
    {
      id: "knee-contour-07",
      // Ambiente em contato: Sem uso (unused-right).
      scope: "upper",
      color: "blue",
      base: { level: "upper.z0" },
      top: "roofs",
      // Vale entre as duas coberturas transversais: altura livre de ~1,37 m.
      // Fecha até o encontro com a água longitudinal, além do recorte de 1,30 m.
      from: ["house-right.x1", "(main-transverse-roof.y1 + rear-transverse-roof.y0) / 2"],
      to: ["main-roof.x1 - (main-transverse-roof.y1 - rear-transverse-roof.y0) / 2", "y0"]
    },
    {
      id: "perimeter-plinth",
      color: "mate-amargo",
      scope: "ground",
      base: "terrain",
      top: "ground.z0",
      path: { points: [
        ["house-left.x0", "dining.y1"],
        ["porch.x0", "porch.y0"],
        ["office.x1", "office.y0"],
        ["kitchen.x1", "kitchen.y0"]
      ] }
    },
    {
      id: "perimeter-plinth-rear",
      color: "mate-amargo",
      scope: "ground-rear",
      base: "terrain",
      top: "ground-rear.z0",
      path: { points: [
        ["house-left.x0", "dining.y1"],
        ["porch.x0", "garage.y0"],
        ["garage.x0", "garage.y0"],
        ["garage.x0", "garage.y1"],
        ["garage.x1", "garage.y1"],
        ["garage.x1", "mudroom.y1"],
        ["pantry.x1", "pantry.y1"],
        ["terrace.x0", "terrace.y1"],
        ["terrace.x1", "terrace.y1"],
        ["kitchen.x1", "kitchen.y0"]
      ] }
    },
    {
      id: "front-wall",
      scope: "ground",
      top: "upper.z0",
      path: { points: [["hall.x1", "hall.y0"], ["hall.x0", "y0"], ["x0", "house-left.y0"], ["house-left.x0", "y0"]] }
    },
    {
      id: "office-walls",
      scope: "ground",
      top: "upper.z0",
      path: {
        points: [
          ["office.x1", "office.y1"],
          ["x0", "office.y0"],
          ["office-main.x0", "y0"],
          ["x0", "hall.y0"],
          ["office-extension.x0", "y0"],
          ["x0", "office.y1"]
        ]
      }
    },
    {
      id: "rear-wall",
      scope: "ground-rear",
      base: { level: "ground-rear.z0" },
      top: "upper-rear.z0",
      path: {
        points: [
          ["kitchen.x1", "kitchen.y1"],
          ["kitchen.x0", "y0"],
          ["pantry.x1", "pantry.y1"],
          ["mudroom.x0", "mudroom.y1"]
        ]
      }
    },
    {
      id: "left-wall",
      scope: "ground",
      top: "upper.z0",
      from: ["house-left.x0", "living.y0"],
      to: ["x0", "dining.y1"]
    },
    {
      id: "left-wall-rear",
      scope: "ground-rear",
      base: { level: "ground-rear.z0" },
      top: "upper-rear.z0",
      from: ["house-left.x0", "dining.y1"],
      to: ["x0", "mudroom.y1"]
    },
    // Azul: trechos do pavimento Dormitórios sem parede coincidente no térreo.
    {
      id: "upper-front-wall-offset",
      scope: "upper",
      color: "blue",
      base: { level: "upper.z0" },
