      clip_intersections: false,
      base: "porch",
      orientation: "transverse",
      slope: "top",
      pitch: 20,
      thickness: "params.roof_thickness_20",
      z0: "ground.z0 + 2.7",
      eaves: { left: 0.45, right: 0, pitch: 20 },
      rake: [0.25, 0]
    },
    {
      id: "terrace-roof",
      label: "Cobertura do terraço",
      type: "shed",
      clip_intersections: false,
      base: "terrace",
      orientation: "transverse",
      slope: "bottom",
      pitch: 20,
      thickness: "params.roof_thickness_20",
      z0: "ground-rear.z0 + 2.7",
      eaves: { left: 0, right: 0.45, pitch: 20 },
      rake: [0.25, 0]
    },
    {
      id: "main-roof",
      label: "Telhado Principal",
      z0: "upper.z0 + params.roof_base_offset",
      rectangle: ["main.x0", "hall.y0", "office-main.x0 + 1.6", "kitchen.y1"],
      orientation: "longitudinal",
      eaves: { left: 0.5, right: 0 }
    },
    {
