      scope: "upper",
      base: { level: "upper.z0" },
      path: {
        points: [
          ["main-right.x1", "office.y1"],
          ["office.x1", "y0"],
          ["x0", "office.y0"],
          ["office-main.x0", "y0"],
          ["x0", "main.y0"]
        ]
      }
    },
    {
      id: "upper-front-wall",
      scope: "upper",
      base: { level: "upper.z0" },
      path: {
        points: [["office-main.x0", "hall.y0"], ["hall.x0", "y0"], ["x0", "house-left.y0"], ["house-left.x0", "y0"]]
      }
    },
    {
      id: "upper-right-wall",
      scope: "upper",
