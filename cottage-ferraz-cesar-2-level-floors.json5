          label: "Escada",
          parts: [
            {
              id: "lower-flight",
              risers: 11,
              from: ["lower-landing.x1", "lower-landing.y0", "lower-landing.z0"],
              to: ["house-left.x1", "lower-landing.y1", "ground-rear.z0"],
              walls: ["front", "rear"]
            },
            {
              id: "lower-landing",
              from: ["house-left.x0", "upper-landing.y1", "upper-landing.z0"],
              to: ["x0 + 1.2", "y0 + upper-flight.l", "z0"],
              walls: ["rear"],
              kind: "landing",
              color: "terracotta"
            },
            {
              id: "upper-flight",
              risers: 7,
              from: ["house-left.x1 - 1.2", "dining.y1", "upper-rear.z0"],
              to: ["x0 - 1.86", "y0 + 1.2", "ground-rear.z0 + (upper-rear.z0 - ground-rear.z0) * 11 / 18"]
            },
            {
              id: "upper-landing",
              from: ["upper-flight.x0", "upper-flight.y0", "upper-flight.z0"],
              to: ["house-left.x0", "upper-flight.y1", "z0"],
              kind: "landing",
              color: "terracotta"
            }
          ],
          walls: [],
          overlaps: ["powder", "laundry"],
          overlays: ["powder", "laundry"]
        }
      ],
      rooms: [
        {
          id: "circulation",
          top: "upper-rear.z0",
          label: "Circulação",
          rectangle: ["house-left.x1 - 2", "laundry.y1", "house-left.x1", "y0 + 1"],
          classes: "circulation"
        },
        {
