      base: { level: "upper.z0" },
      top: "upper.z0 + params.floor_height",
      from: ["bedroom-north.x0", "hall.y1"],
      to: ["x0", "bedroom-north.y1"]
    },
    {
      id: "bedroom-north-rear",
      scope: "bedroom-north",
      color: "blue",
      base: { level: "upper.z0" },
      top: "upper.z0 + params.floor_height",
      from: ["bedroom-north.x0", "bedroom-north.y1"],
      to: ["bedroom-north.x1", "y0"]
    },
    {
      id: "upper-service-left-wall",
      scope: "upper-rear",
      base: { level: "upper-rear.z0" },
      from: ["mudroom.x0", "kitchen.y1"],
