// Versão paramétrica cartesiana de cottage-ferraz-cesar.json5.
// X cresce da esquerda para a direita; Y cresce da frente aos fundos (baixo para cima).
// X = 0 na lateral direita do corpo principal; a geometria à esquerda usa X negativo.
// Fórmulas, parâmetros e IDs são preservados; o original não é substituído.
// walls e openings: left = x0; right = x1. top/bottom continuam frente/fundos.
// Beirais longitudinais: left/right = x0/x1; transversais: frente/fundos.
// from/to preservam o sentido dos lances de escada; não precisam estar em ordem crescente.
// Terreno cadastral e building permanecem no referencial de implantação.

{
  $schema: "./floor-plan.schema.json",
  coordinate_system: "cartesian",
  title: "Cottage Ferraz-César",
  summary: "Residência de dois pavimentos em terreno cadastrado com diferença de cota de 6 m entre frente e fundos.",
  coordinates: ["25°45'06.7\"S", "49°15'29.1\"W"],
  viewport: { size: [24, 32], origin: [-25, 1] },
  // Configuração
  config: {
    walls: { base: { level: "ground.z0" }, top: "roof", thickness: "params.wall_thickness", color: "desejo-ambar" },
    roofs: { type: "gable", pitch: 51 },
    openings: {
      door: { w: 0.8, h: 2.1, z0: 0 },
      window: { w: 0.9, h: 1.5, z0: 0.9 },
      opening: { w: 1, h: 2.1, z0: 0 }
    },
    floors: { ceiling_height: "params.ground_height" }
  },
  // Parâmetros preservados
  parameters: {
    wall_thickness: 0.12,
    ground_height: 3,
    headroom_2m_inset: 0.809785,
    headroom_3m_inset: 1.619569,
    office_headroom_2m_inset: 0.809785,
    office_headroom_3m_inset: 1.619569,
    knee_setback: 0.8
  },
  // Terreno cadastral
  terrain: {
    front: { edge: ["P001", "P002"], position: "top", label: "RUA/FRENTE" },
    rear: { edge: ["P013", "P014"], position: "bottom", label: "JARDIM" },
    // Perfil longitudinal de estudo. IDs e cotas intermediárias provisórios.
    // Y local do terreno; piso térreo = 0. Não são cotas de execução.
    grading: {
      profile: [
        { id: "tp-01-rua", y: 0, z: 0 },
        { id: "tp-02-entrada", y: 3, z: -0.45 },
        { id: "tp-03-inicio-descida", y: 12, z: -0.45 },
        // Recuo de 3 m + envelope térreo de 20,8 m (inclui garagem).
        { id: "tp-04-fundos-casa", y: 23.8, z: -0.9 },
        { id: "tp-05-jardim", y: 29, z: -1.5 },
        // Início aproximado da divisa oblíqua dos fundos em Y.
        // A cota fica constante em -6 m depois deste ponto.
        { id: "tp-06-fundos-terreno", y: 44.32, z: -6 }
      ]
    },
    north: { label: "N" },
    unit: "m",
    boundary_order: ["P002", "P001", "P014", "P013"],
    corners: {
      P001: { easting: 674815.253, northing: 7150521.976, z: 0 },
      P002: { easting: 674798.334, northing: 7150529.176, z: 0 },
      P013: { easting: 674783.457, northing: 7150487.338, z: -6 },
      P014: { easting: 674800.113, northing: 7150476.994, z: -6 }
    },
    segments: [
      { from: "P001", to: "P002", distance: 18.387, azimuth_deg: 293.052521, azimuth_dms: "293° 03' 09\"" },
      { from: "P002", to: "P013", distance: 44.404, azimuth_deg: 199.574666, azimuth_dms: "199° 34' 29\"" },
      { from: "P013", to: "P014", distance: 19.607, azimuth_deg: 121.84183, azimuth_dms: "121° 50' 31\"" },
      { from: "P014", to: "P001", distance: 47.462, azimuth_deg: 18.601256, azimuth_dms: "18° 36' 05\"" }
    ]
  },
  // Implantação no terreno
  building: { anchor: "terrain.front-start", position: { x: 4, y: 3 } },
  // Zonas de referência
  zones: [
    { id: "attic", inset: ["main", 3, 0], color: "red", visible: false },
    { id: "bottom", rectangle: ["main.x0", "main.y0 + main.l / 2", "main.x1", "main.y1"], visible: false },
    { id: "central", from: ["main.xc + 0.7", "main.y0"], to: ["x0 - 1.4", "main.y1"], visible: false },
    { id: "comfort-zone", inset: ["main", 1.8, 0], color: "blue", visible: false },
