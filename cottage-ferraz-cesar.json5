      // Mobiliário e equipamentos.
      items: [
        // Camas Twin de 0,97 × 1,91 m; posições compensam a rotação em torno do centro.
        // Quarto E: cabeceiras à direita da planta; três espaços iguais entre camas e faces internas frontal/traseira.
        { id: "bed-east", type: "twin-bed", pos: ["bedroom-east.x1 - 1.44 - params.wall_thickness / 2", "bedroom-east.y0 + params.wall_thickness / 2 + (bedroom-east.l - params.wall_thickness - 1.94) / 3 - 0.47"], rotation: 90 },
        { id: "bed-east-2", type: "twin-bed", pos: ["bedroom-east.x1 - 1.44 - params.wall_thickness / 2", "bedroom-east.y0 + params.wall_thickness / 2 + 2 * (bedroom-east.l - params.wall_thickness - 1.94) / 3 + 0.97 - 0.47"], rotation: 90 },
        // Quarto N: cabeceira à esquerda da planta, cama centralizada entre frente e fundo.
        { id: "bed-north-1", type: "queen-bed", pos: ["bedroom-north.x0 + 0.2 + params.wall_thickness / 2", "bedroom-north.yc - 1"], rotation: 270 },
        // Quarto Oeste: cabeceiras à direita da planta; faixa de circulação aos pés e entre camas.
        { id: "bed-west-1", type: "twin-bed", pos: ["bedroom-west.x1 - 1.44 - params.wall_thickness / 2", "bedroom-west.y0 + 0.3"], rotation: 90 },
        { id: "bed-west-2", type: "twin-bed", pos: ["bedroom-west.x1 - 1.44 - params.wall_thickness / 2", "bedroom-west.y1 - 1.74"], rotation: 90 },
        // Criados junto às cabeceiras; modelos compactos nos quartos com camas Twin.
        { id: "nightstand-east-1", label: "Criado-mudo", pos: ["bed-east.xc + bed-east.l / 2 - 0.4", "bed-east.yc - bed-east.w / 2 - 0.45"], size: [0.4, 0.4, 0.55], classes: "furniture storage nightstand", color: "furniture" },
        { id: "nightstand-east-2", label: "Criado-mudo", pos: ["bed-east-2.xc + bed-east-2.l / 2 - 0.4", "bed-east-2.yc + bed-east-2.w / 2 + 0.05"], size: [0.4, 0.4, 0.55], classes: "furniture storage nightstand", color: "furniture" },
        { id: "nightstand-north-1", label: "Criado-mudo", pos: ["bed-north-1.xc - bed-north-1.l / 2", "bed-north-1.yc - bed-north-1.w / 2 - 0.55"], size: [0.5, 0.5, 0.55], classes: "furniture storage nightstand", color: "furniture" },
        { id: "nightstand-north-2", label: "Criado-mudo", pos: ["bed-north-1.xc - bed-north-1.l / 2", "bed-north-1.yc + bed-north-1.w / 2 + 0.05"], size: [0.5, 0.5, 0.55], classes: "furniture storage nightstand", color: "furniture" },
        { id: "nightstand-west-1", label: "Criado-mudo", pos: ["bed-west-1.xc + bed-west-1.l / 2 - 0.4", "bed-west-1.yc - bed-west-1.w / 2 - 0.45"], size: [0.4, 0.4, 0.55], classes: "furniture storage nightstand", color: "furniture" },
        { id: "nightstand-west-2", label: "Criado-mudo", pos: ["bed-west-2.xc + bed-west-2.l / 2 - 0.4", "bed-west-2.yc - bed-west-2.w / 2 - 0.45"], size: [0.4, 0.4, 0.55], classes: "furniture storage nightstand", color: "furniture" },
        // Armários baixos sob a água do telhado; portas de correr a detalhar.
        { id: "wardrobe-west-front", title: "Armário baixo — Quarto Oeste", pos: ["bedroom-west.x0 + 0.06", "bedroom-west.y0 + 0.06"], size: [0.8, 0.6, 1.2], classes: "storage", color: "furniture" },
        { id: "wardrobe-west-rear", title: "Armário baixo — Quarto Oeste", pos: ["bedroom-west.x0 + 0.06", "bedroom-west.y1 - 0.66"], size: [0.8, 0.6, 1.2], classes: "storage", color: "furniture" },
        // Borda frontal do vão; chegada do lance superior permanece livre à esquerda da planta.
        { id: "stair-arrival-railing", type: "railing", label: "Guarda-corpo do desembarque", pos: ["upper-flight.x1", "stairs.y0 - 0.08"], size: ["stairs.x1 - upper-flight.x1 - params.wall_thickness / 2", 0.08, 1.1] }
      ],
      // Aberturas do pavimento; aberturas locais ficam dentro do cômodo.
      openings: [
        { type: "opening", from: "upper", to: "ground", rectangle: ["stairs.x0 + 1.2", "stairs.y0", "stairs.x1", "stairs.y1"] }
      ]
    }
