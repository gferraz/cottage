#!/bin/sh

set -eu

if [ "$#" -ne 1 ]; then
  printf 'Uso: floor <arquivo.json>\n' >&2
  exit 2
fi

json_file=$1
if [ ! -f "$json_file" ]; then
  printf 'Arquivo não encontrado: %s\n' "$json_file" >&2
  exit 1
fi

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
encoded_json=$(base64 < "$json_file" | tr -d '\n')
open "file://${script_dir}/floor-plan.html#json=${encoded_json}"
